        <!-- Section 1: Ներածություն և Կանոններ -->
        <section id="rules">
            <h2>Ակումբի Նկարագրությունը և Կանոնները</h2>
            <article>
                <h3>Մեր Ակումբի Մասին</h3>
                <p>
                    Մեր ակումբը հիմնադրվել է <b>2024</b> թվականին։ Մենք առաջարկում ենք ավելի քան <strong>100 տարբեր խաղեր</strong>։ 
                    Խաղասենյակի մակերեսը կազմում է 150 m<sup>2</sup>, որտեղ միշտ առկա է զովացուցիչ H<sub>2</sub>O ջուր բոլոր մասնակիցների համար։
                </p>
                <p>
                    <i>Ուշադրություն․</i> Մուտքի վճարը նախկինում <del>2000 Դրամ</del> էր, իսկ հիմա ընդամենը <ins>1500 Դրամ</ins> է ամբողջ օրվա համար։ 
                    <mark>Կարևոր զգուշացում․</mark> խաղաքարերը կորցնելու դեպքում գործում է տուգանք։ 
                    <s>Հին կանոնակարգը այլևս չի գործում։</s>
                </p>
            </article>

            <article>
                <h3>Ակումբի Հիմնական Կանոնները (Unordered List)</h3>
                <ul>
                    <li>Հարգել մյուս խաղացողներին և ակումբի գույքը։</li>
                    <li>Խաղերն օգտագործելուց հետո վերադարձնել նույն տեղում։
                        <ul>
                            <li>Խաղաքարերը դասավորել տուփի մեջ։</li>
                            <li>Մաքրել խաղասեղանը խաղից հետո։</li>
                        </ul>
                    </li>
                    <li>Սնունդն ու խմիչքը պահել խաղասեղաններից հեռու։</li>
                    <li>Խաղի ընթացքում հետևել <em>ազնիվ խաղի (Fair Play)</em> սկզբունքներին։</li>
                </ul>
            </article>
        </section>

        <hr>

        <!-- Section 2: Խաղին միանալը և Տերմինները -->
        <section id="how-to-join">
            <h2>Ինչպես Միանալ Խաղին և Տերմինաբանություն</h2>
            
            <article>
                <h3>Խաղին Միանալու 4 Քայլերը (Ordered List)</h3>
                <ol>
                    <li>Գրանցվել ակումբի ընդունարանում կամ կայքում։</li>
                    <li>Ընտրել խաղը մեր հարուստ հավաքածուից։</li>
                    <li>Ծանոթանալ խաղի կանոններին կամ դիմել խաղավարին։</li>
                    <li>Սկսել խաղը և վայելել ժամանակը։</li>
                </ol>
            </article>

            <article>
                <h3>Հիմնական Տերմիններ (Definition List)</h3>
                <dl>
                    <dt><dfn>Ռազմավարություն</dfn></dt>
                    <dd>Երկարաժամկետ պլանավորման մեթոդ, որն օգտագործվում է խաղում հաղթանակի հասնելու համար։</dd>
                    
                    <dt><dfn>Հերթ</dfn></dt>
                    <dd>Ժամանակահատված, որի ընթացքում մեկ խաղացողը կատարում է իր քայլը։</dd>
                    
                    <dt><dfn>Միավոր</dfn></dt>
                    <dd>Չափման միավոր, որը հաշվարկվում է խաղացողի հաջողությունները գնահատելու համար։</dd>
                </dl>
            </article>
        </section>

